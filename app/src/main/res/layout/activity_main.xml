<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/res/layout/activity_main.xml -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF8FF"
    tools:context=".p5editor.MainActivity">

    <!-- Top Action Toolbar (M3 Professional Polish Header) -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FDF8FF"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Brand Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="p5.studio"
            android:textColor="#1C1B1F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="12dp" />

        <!-- Scrollable Button Container to prevent wrapping on narrow screens -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Preset Templates Selector Button -->
                <Button
                    android:id="@+id/btn_presets"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Presets"
                    android:textColor="#6750A4"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    app:strokeColor="#E7E0EC"
                    app:cornerRadius="19dp" />

                <!-- Run Sketch Button (M3 Primary Pill) -->
                <Button
                    android:id="@+id/btn_run"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▶ RUN"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6750A4"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    app:cornerRadius="19dp" />

                <!-- Stop Sketch Button (M3 Primary Container Pill) -->
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="⏹ STOP"
                    android:textColor="#21005D"
                    android:backgroundTint="#EADDFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    app:cornerRadius="19dp" />

                <!-- Toggle Editor Overlay Button -->
                <Button
                    android:id="@+id/btn_toggle_editor"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="&lt;/&gt;"
                    android:textColor="#1C1B1F"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    app:strokeColor="#E7E0EC"
                    app:cornerRadius="19dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Header Divider Line -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7E0EC"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Embedded Hardware-Accelerated WebView -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toTopOf="@id/status_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Status and Console Log Strip -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2B2930"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ AndroidBridge ready"
            android:textColor="#D0BCFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS ●"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
